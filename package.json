{
  "name": "cryptochain",
  "version": "1.0.0",
  "description": "A simplified blockchain implementation with cryptocurrency features.",
  "scripts": {
    "test": "jest",
    "start": "npm run build-client && node index.js",
    "dev": "npm run start-redis & cross-env ENV='development' nodemon index.js",
    "dev-peer": "cross-env GENERATE_PEER_PORT='true' ENV='development' nodemon index.js",
    "start-redis": "redis-server",
    "build-client": "npm run clean && parcel build client/src/index.html --dist-dir client/dist",
    "dev-client": "npm run clean && parcel client/src/index.html --dist-dir client/dist",
    "clean": "rm -rf .parcel-cache client/dist"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "keywords": [
    "blockchain",
    "cryptocurrency",
    "node",
    "express",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.14.3",
    "@babel/preset-react": "^7.13.13",
    "cross-env": "^7.0.2",
    "jest": "^29.7.0",
    "nodemon": "^2.0.4",
    "parcel": "^2.12.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "autoprefixer": "^10.4.19"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "elliptic": "^6.5.7",
    "express": "^4.19.2",
    "hex-to-binary": "^1.0.1",
    "history": "^4.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "redis": "^4.6.13",
    "uuid": "^9.0.1"
  }
}
